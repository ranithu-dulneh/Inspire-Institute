{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "inspire-institute-lms",
  "main": "src/worker.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "materials"
    }
  ],
  "vars": {
    "R2_PUBLIC_URL": "https://pub-3c50a30d70944cc59a4fef93e7939680.r2.dev",
    "VITE_R2_PUBLIC_URL": "https://pub-3c50a30d70944cc59a4fef93e7939680.r2.dev"
  }
}
