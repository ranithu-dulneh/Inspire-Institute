# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Database Configuration
VITE_SUPABASE_URL="https://nekzlcfwwkumyofielep.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Cloudflare R2 Storage (S3-Compatible Object Storage)
# Match variables configured in Cloudflare Workers / Pages
VITE_R2_ACCOUNT_ID="7f20af5256805acd5508b3d4f770d521"
VITE_R2_ACCESS_KEY_ID="175c190fc5c10effccd9ce3f8a202c6e"
VITE_R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
VITE_R2_BUCKET_NAME="materials"
VITE_R2_PUBLIC_URL="https://pub-13c8a61be13043eeb6acf002759522b9.r2.dev"

# Alternative server environment variable aliases supported:
CLOUDFLARE_R2_ACCOUNT_ID="7f20af5256805acd5508b3d4f770d521"
CLOUDFLARE_R2_ACCESS_KEY_ID="175c190fc5c10effccd9ce3f8a202c6e"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
CLOUDFLARE_R2_BUCKET_NAME="materials"
CLOUDFLARE_R2_PUBLIC_URL="https://pub-13c8a61be13043eeb6acf002759522b9.r2.dev"

